    "broadcast.line.1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I just gave my home screen a personality. Meet Abstrakt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le acabo de dar personalidad a mi pantalla de inicio. Les presento a Abstrakt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar Utama saya baru dapat kepribadian. Kenalan sama Abstrakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acabei de dar personalidade à minha tela inicial. Conheçam o Abstrakt."
          }
        }
      }
    },
    "broadcast.line.2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop me before I rearrange my widgets again. Abstrakt did this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deténganme antes de que reorganice mis widgets otra vez. Culpa de Abstrakt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hentikan saya sebelum saya nyusun ulang widget lagi. Gara-gara Abstrakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me impeçam antes que eu reorganize meus widgets de novo. Culpa do Abstrakt."
          }
        }
      }
    },
    "broadcast.line.3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your home screen called. It wants Abstrakt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pantalla de inicio llamó. Quiere Abstrakt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar Utama kamu nelpon. Katanya minta Abstrakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua tela inicial ligou. Ela quer Abstrakt."
          }
        }
      }
    },
    "broadcast.line.4" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns out my widgets were boring. Fixed that with Abstrakt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resulta que mis widgets eran aburridos. Lo arreglé con Abstrakt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ternyata widget saya biasa aja. Dibenerin sama Abstrakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descobri que meus widgets eram sem graça. Resolvi com Abstrakt."
          }
        }
      }
    },
    "broadcast.line.5" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Made my home screen actually mine. Abstrakt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hice que mi pantalla de inicio fuera realmente mía. Abstrakt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bikin Layar Utama saya beneran punya saya. Abstrakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixei minha tela inicial realmente minha. Abstrakt."
          }
        }
      }
    },
