    },
    "%@ %@." : {
      "comment" : "A line that displays the distance walked, followed by the unit of measurement. The unit of measurement is determined by the device's locale settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@."
          }
        }
      }
    },
    "%@ | %@" : {
      "comment" : "A label displaying the name of a widget and its category. The first argument is the name of the widget. The second argument is the title of its primary category.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ | %2$@"
          }
        }
      }
    },
    "%@ ago" : {
      "comment" : "A label showing how long ago the latest heart rate data was recorded. The argument is a `Date` value representing the timestamp of the latest data point.",
      "isCommentAutoGenerated" : true
    },
    "%@ in %@" : {
      "comment" : "A text that combines the weather condition and the location name.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ in %2$@"
          }
        }
      }
    },
    "%@ steps," : {
      "comment" : "A label displaying the number of steps taken. The argument is the number of steps.",
      "isCommentAutoGenerated" : true
    },
    "%lld" : {
      "comment" : "A badge displaying the number of items in a library. The badge's text is the count of items in the library.",
      "isCommentAutoGenerated" : true
    },
    "%lld%%" : {
      "comment" : "A label displaying the battery level as a percentage. The argument is the battery level as a percentage.",
      "isCommentAutoGenerated" : true
    },
    "%lld°" : {
      "comment" : "A label displaying the high temperature for the day. The argument is the high temperature.",
      "isCommentAutoGenerated" : true
    },
    "%lld° now in %@" : {
      "comment" : "A line displaying the current temperature and the name of the place. The first argument is the temperature, formatted as a whole number. The second argument is the name of the place.",
