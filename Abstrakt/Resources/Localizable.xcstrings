    "%@ (%lld)" : {
      "comment" : "A button that displays a widget size and the number of presets available for that size. The first argument is the widget size. The second argument is the count of presets for that size.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$lld)"
          }
        }
      }
    },
    "%@ %@." : {
      "comment" : "A unit of distance.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@."
          }
        }
      }
    },
