      }
    },
    "broadcast.line.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop me before I rearrange my widgets again. Abstrakt did this."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hentikan saya sebelum saya nyusun ulang widget lagi. Gara-gara Abstrakt."
